# NEO-HMS Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Backend API Base URL ─────────────────────────────────────────────────────
# Development (local backend):
VITE_API_BASE_URL=http://localhost:5000/api

# Production (deployed backend on Render / Railway / etc):
# VITE_API_BASE_URL=https://your-neohms-backend.onrender.com/api

# ── IMPORTANT ────────────────────────────────────────────────────────────────
# Do NOT add MongoDB URI, JWT_SECRET, DB passwords, or private API keys here.
# This file is bundled into the browser — only public, frontend-safe values go here.
